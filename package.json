{
  "name": "mainframe-hub-assistant",
  "displayName": "Mainframe Hub Assistant",
  "publisher": "mainframe-hub",
  "description": "Uma camada inteligente de suporte à migração TSO -> VS Code e desenvolvimento Mainframe.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "mainframe.hubAssistant",
        "name": "mainframehub",
        "description": "Assistente Mainframe: TSO, Zowe, JCL, COBOL e Otimização de IA",
        "isSticky": true,
        "commands": [
          {
            "name": "como-fazia-no-tso",
            "description": "Como fazer algo que antes era feito no TSO/ISPF"
          },
          {
            "name": "explicar",
            "description": "Explicar sintaxe ou processo"
          },
          {
            "name": "onboarding",
            "description": "Guia inicial passo a passo"
          },
          {
            "name": "abend",
            "description": "Ajuda com troubleshooting de ABENDs"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "mainframeHub.testZoweReadOnly",
        "title": "Mainframe Hub: Test Zowe Read-Only"
      },
      {
        "command": "mainframeHub.testModelAccess",
        "title": "Mainframe Hub: Test Model Access"
      },
      {
        "command": "mainframeHub.testGpt4oMiniCall",
        "title": "Mainframe Hub: Test GPT-4o Mini Call"
      },
      {
        "command": "mainframeHub.testContextProcessor",
        "title": "Mainframe Hub: Test Context Processor"
      },
      {
        "command": "mainframeHub.testJclSkillPipeline",
        "title": "Mainframe Hub: Test JCL Skill Pipeline"
      },
      {
        "command": "mainframeHub.testJclRouterPipeline",
        "title": "Mainframe Hub: Test JCL Router Pipeline"
      },
      {
        "command": "mainframeHub.testJclLlmPipeline",
        "title": "Mainframe Hub: Test JCL LLM Pipeline"
      },
      {
        "command": "mainframeHub.pinProfile",
        "title": "Mainframe Hub: Pin Zowe Profile"
      },
      {
        "command": "mainframeHub.unpinProfile",
        "title": "Mainframe Hub: Unpin Zowe Profile"
      }
    ],
    "configuration": {
      "title": "Mainframe Hub Assistant",
      "properties": {
        "mainframeHub.workspaceProfile": {
          "type": "string",
          "default": "",
          "description": "Nome do profile Zowe (zosmf) preferido para este workspace. Usado quando não há RESOURCE_CONTEXT nem profile pinnado na sessão."
        },
        "mainframeHub.workspaceProfileEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Habilita o uso do profile de workspace (mainframeHub.workspaceProfile) na cadeia de resolução."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test:core": "npm run compile && node --test out/test/core-hardening.test.js",
    "test:profile": "npm run compile && node --test out/test/profile-context.test.js",
    "test:model-router": "npm run compile && node --test out/test/model-router.test.js",
    "test:knowledge-selector": "npm run compile && node --test out/test/knowledge-selector.test.js",
    "test:all": "npm run compile && node --test out/test/core-hardening.test.js out/test/profile-context.test.js out/test/model-router.test.js out/test/knowledge-selector.test.js"
  },
  "dependencies": {
    "@zowe/core-for-zowe-sdk": "^8.37.1",
    "@zowe/imperative": "^8.37.1",
    "@zowe/zos-files-for-zowe-sdk": "^8.37.1",
    "@zowe/zos-jobs-for-zowe-sdk": "^8.37.1",
    "@zowe/zowe-explorer-api": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.89.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.3.3"
  }
}
