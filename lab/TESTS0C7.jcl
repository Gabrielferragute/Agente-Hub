//TESTS0C7 JOB (ACCT),'LAB S0C7',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//* LABORATORIO: FORCA UM ABEND S0C7 (DATA EXCEPTION) EM COBOL
//* COMPILA + LINK + EXECUTA COM A PROC PADRAO IGYWCLG
//CLG      EXEC IGYWCLG,PARM.COBOL='OFFSET,SOURCE'
//COBOL.SYSIN DD *
       IDENTIFICATION DIVISION.
       PROGRAM-ID. TESTS0C7.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-ALFA                PIC X(3) VALUE 'ABC'.
       01  WS-NUM REDEFINES WS-ALFA PIC S9(5) COMP-3.
       01  WS-TOTAL               PIC S9(5) COMP-3 VALUE 0.
       PROCEDURE DIVISION.
           DISPLAY 'LAB S0C7: SOMANDO LETRAS EM CAMPO COMP-3...'.
           ADD WS-NUM TO WS-TOTAL.
           DISPLAY 'NAO DEVERIA CHEGAR AQUI: ' WS-TOTAL.
           STOP RUN.
/*
